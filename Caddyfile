# Caddyfile — PRM POLSER
# Serveix el portal React (build estátic) i el proxy a Directus (/directus).
# Òs: en producció apuntar CADDY_SITE_NAME al domini real i tenir DNS+TLS.
# En dev local, accedeix a Directus per http://localhost:8055 directament.

{$CADDY_SITE_NAME} {
    root * /srv/portal
    file_server

    # Directus sota el mateix domini (path /directus) -> SPA i API
    handle /directus/* {
        uri strip_prefix /directus
        reverse_proxy directus:8055
    }

    # PWA: serveix index.html per a rutes de l'SPA (bottom-nav-react)
    try_files {path} /index.html

    encode gzip zstd

    # Seguretat bàsica
    header /* {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}