{
  "name": "directus-extension-auth-otp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^12.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/index.js",
    "dev": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/index.js --watch"
  },
  "dependencies": {
    "@directus/errors": "^2.5.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}