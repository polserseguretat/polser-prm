# ===== PRM POLSER — variables d'entorn (copia com a .env i omple) =====
# MAI commitgis el .env real (està a .gitignore).

# --- PostgreSQL (BBDD del PRM) ---
POSTGRES_DB=prm
POSTGRES_USER=prm
POSTGRES_PASSWORD=CHANGE_ME_STRONG

# --- Directus ---
DIRECTUS_KEY=CHANGE_ME_RANDOM       # qualsevol string aleatori
DIRECTUS_SECRET=CHANGE_ME_RANDOM    # mínim 32 caràcters
DIRECTUS_ADMIN_EMAIL=admin@polser.cat
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_STRONG

# --- Publicació / CORS / domini ---
PUBLIC_URL=http://localhost:8055
CORS_ORIGIN=http://localhost:5173
CADDY_SITE_NAME=partners.polser.cat

# --- Portal React (VITE_ prefix -> compilat al build) ---
# URL base de l'API de Directus que usa el portal en producció
VITE_DIRECTUS_URL=/directus