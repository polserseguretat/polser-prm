# ===== PRM POLSER — variables d'entorn (copia com a .env i omple) =====
# MAI commitgis el .env real (està a .gitignore).

# --- PostgreSQL (BBDD del PRM) ---
DB_CLIENT=directus
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=polser-prm
POSTGRES_USER=prm
POSTGRES_PASSWORD=CHANGE_ME_STRONG

# --- Directus ---
DIRECTUS_KEY=CHANGE_ME_RANDOM       # qualsevol string aleatori
DIRECTUS_SECRET=CHANGE_ME_RANDOM    # mínim 32 caràcters
DIRECTUS_ADMIN_EMAIL=admin@polser.cat
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_STRONG

# --- Publicació / CORS / domini ---
# Directus viu a l'arrel d'api.partners.polser.cat, exposat per Cloudflare Tunnel.
PUBLIC_URL=https://api.partners.polser.cat
# El portal (partners.polser.cat a Cloudflare Pages) hi crida en cross-origin.
# ⚠️ UN sol origen, SENSE barra final (el paquet cors l'eco tal qual).
#    En dev local fes servir http://localhost:5173.
CORS_ORIGIN=https://partners.polser.cat

# --- Cloudflare Tunnel ---
# Token del túnel (Zero Trust → Networks → Tunnels). Crea el túnel i el public
# hostname api.partners.polser.cat → http://directus:8055. El token va aquí.
CLOUDFLARE_TUNNEL_TOKEN=

# --- SMTP (enviament d'emails, ex. codis OTP del login) ---
# Proveïdor transaccional: Resend (smtp.resend.com, port 465/SSL).
# El domini polser.cat ha d'estar verificat a Resend per enviar des de no-reply@polser.cat.
EMAIL_FROM="POLSER SEGURETAT <no-reply@polser.cat>"
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=re_XXX_...   # API key de Resend

# --- Portal React (VITE_ prefix -> compilat al build) ---
# Endpoint de l'API Directus en producció. El build de producció es fa a
# Cloudflare Pages: defineix allà la variable
# VITE_DIRECTUS_URL=https://prmcore.polser.cat (baked al build).
# En dev local el default de portal/src/lib/api.ts és http://localhost:8055.
VITE_DIRECTUS_URL=http://localhost:8055

# --- Extensió OTP (F3) ---
# En desenvolupament, revela el codi OTP a la resposta per provar sense SMTP.
# MAI activar-ho en producció.
OTP_DEV_REVEAL=false
